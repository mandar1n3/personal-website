<form class="contact-form" id="contact-form" method="POST">
  <div class="inputContainer">
    <label for="name"> Name </label>
    <input id="name" type="text" name="name" />
    <p class="error-field" id="name-error"></p>
  </div>

  <div class="inputContainer">
    <label for="email"> Email </label>
    <input id="email" type="email" name="email" />
    <p class="error-field" id="email-error"></p>
  </div>

  <div class="inputContainer">
    <label for="subject"> Subject </label>
    <input id="subject" type="text" name="subject" />
    <p class="error-field" id="subject-error"></p>
  </div>

  <div class="inputContainer">
    <label for="message"> Message </label>
    <textarea id="message" name="message"></textarea>
    <p class="error-field" id="message-error"></p>
  </div>

  <button class="contact-form-submit-btn" type="submit">Send</button>
</form>

<script>
  import { actions, isInputError } from "astro:actions";

  const form = document.querySelector("#contact-form");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const formData = new FormData(form as HTMLFormElement);

    const { data, error } = await actions.contactForm(formData);

    if (isInputError(error)) {
      error.fields.name
        ? renderErrorMessage("name", error.fields.name.join(","))
        : clearErrorMessage("name");

      error.fields.subject
        ? renderErrorMessage("subject", error.fields.subject.join(","))
        : clearErrorMessage("subject");

      error.fields.email
        ? renderErrorMessage("email", error.fields.email.join(","))
        : clearErrorMessage("email");

      error.fields.message
        ? renderErrorMessage("message", error.fields.message.join(","))
        : clearErrorMessage("message");
    }

  });

  function renderErrorMessage(id: string, msg: string) {
    const element = document.querySelector(`#${id}-error`);
    if (element) {
      element.classList.add("message-error");
      element.textContent = msg;
    }
  }

  function clearErrorMessage(id: string) {
    const element = document.querySelector(`#${id}-error`);
    if (element) {
      element.classList.remove("message-error");
      element.textContent = "";
    }
  }
</script>
