---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import ContactForm from "../components/ContactForm.astro";
import * as data from "../data.json";

const pageTitle = "Arno Volts";

const experiences = data.experiences;
---

<Layout {pageTitle}>
  <Navigation />
  <header id="top" class="main-header">
    <div class="main-header-body">
      <h1 class="heading">
        <span>Arno Volts</span>
        <span class="sub-heading">Full-stack Web Developer</span>
      </h1>

      <p>
        Hello, I am Arno a 29 year old passionate fullstack developer with two
        years of experience. Outside of programming I love cycling and reading
        books. My goal is to build high performance and reliable web products,
        while continuing to grow within an experienced and challenging technical
        team.
      </p>
    </div>
  </header>
  <main>
    <section class="home-section">
      <h2 class="home-section-heading">The Journey So Far</h2>

      {
        experiences.map((exp) => (
          <ExperienceCard
            years={exp.years}
            company={exp.company}
            description={exp.description}
          />
        ))
      }
    </section>

    <section class="home-section" id="about">
      <h2 class="home-section-heading">A little About Me</h2>
      <p>
        Hi, I am Arno. A 29 year old web artisan based in Belgium. In addition
        to web development, I enjoy reading books and occasionally playing
        chess. I find that these hobbies help me stay creative and
        intellectually stimulated, which translates to my work as a developer.
        My goal is to use my skills and knowledge to build innovative and
        user-friendly websites that meet my clients's needs. I believe that the
        best websites are not only functional but also visually appealing and
        easy to use.
      </p>
    </section>

    <section class="home-section" id="contact">
      <h2 class="home-section-heading">Send Me A Message</h2>
      <div class="contact-section">
        <p>
          If you are interseted in working with me or to know more about me, you
          can reach out via <a href="https://www.linkedin.com/in/volts/" target="_blank">
            linkedin</a
          > or by submiting the form below. You can also check my github profile <a
            href="https://www.github.com/mandar1n3">@mandar1n3</a
          >
        </p>
        <ContactForm />
      </div>
    </section>
  </main>
</Layout>
